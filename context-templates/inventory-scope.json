{
  "regions": ["us-east-1"],
  "regionScope": "single",
  "regionScopeOptions": {
    "single": "Scans only the first region in the regions array",
    "multi": "Scans all regions listed in the regions array",
    "all": "Discovers and scans ALL enabled regions in the account (ignores regions array)"
  },
  "outputDir": "./inventory-reports",
  "includeTags": true,
  "includeCostSummary": false,
  "scanMode": "full",
